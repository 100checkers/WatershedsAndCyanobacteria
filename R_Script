#PROBIT REGRESSION FOR FOREST
#Probit regression
forest_probit <- glm(MaxCD_Forest ~ TN_Forest + TP_Forest, data = DataByWatershed,
                     family = binomial(link = "probit"))

coeftest(forest_probit, vcovHC(forest_probit, "HC0"))
#__________________________________________________________________________
#                                 Initial models
#__________________________________________________________________________
#Build the models 

Forest <- lm(MaxCD_Forest ~ TN_Forest + TP_Forest + Precip_Forest, data = DataByWatershed)

AgricultureStrat <- lm(MaxCD_AgricultureStrat ~ TN_AgricultureStrat + TP_AgricultureStrat + Precip_AgricultureStrat, data = DataByWatershed)

AgricultureNoStrat <- lm(MaxCD_AgricultureNoStrat ~ TN_AgricultureNoStrat + TP_AgricultureNoStrat + Precip_AgricultureNoStrat, data = DataByWatershed)

#Create a list of robust standard errors:
Watershed_rob_se <- list(sqrt(diag(vcovHC(Forest, type = "HC0"))),
                         sqrt(diag(vcovHC(AgricultureStrat, type = "HC0"))),
                         sqrt(diag(vcovHC(AgricultureNoStrat, type = "HC0"))))

#Regression table using RSE in latex:
stargazer(Forest, AgricultureStrat, AgricultureNoStrat, 
          se = Watershed_rob_se, 
          type = "text",
          title = "Regression Table of Models Using Grouping by Watershed Type")

